{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Request Duration Heatmap",
      "description": "Distribution of HTTP request durations across histogram buckets. Darker cells = more requests at that latency.",
      "type": "heatmap",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_ms_bucket{route!=\"unmatched\"}[$__rate_interval])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ],
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "exponent": 0.5,
          "fill": "dark-orange",
          "mode": "scheme",
          "reverse": false,
          "scale": "exponential",
          "scheme": "Oranges",
          "steps": 64
        },
        "yAxis": {
          "axisPlacement": "left",
          "unit": "ms"
        },
        "tooltip": {
          "show": true,
          "yHistogram": true
        },
        "showValue": "never"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "scaleDistribution": { "type": "log", "log": 2 }
          }
        },
        "overrides": []
      }
    },
    {
      "title": "API Request Count by Route",
      "description": "Rate of incoming HTTP requests per second, broken down by route pattern.",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_ms_count{route!=\"unmatched\"}[$__rate_interval])) by (route)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": { "mode": "normal" },
            "barAlignment": 0,
            "showPoints": "never",
            "lineWidth": 0
          },
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "title": "Error Rate per Route",
      "description": "Rate of 4xx client errors and 5xx server errors per second, broken down by status code and route.",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_ms_count{status_code=~\"5..\"}[$__rate_interval])) by (route, status_code)",
          "legendFormat": "{{status_code}} {{route}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_request_duration_ms_count{status_code=~\"4..\"}[$__rate_interval])) by (route, status_code)",
          "legendFormat": "{{status_code}} {{route}}",
          "refId": "B"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.01, "color": "orange" },
              { "value": 0.1, "color": "red" }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "^5\\d{2}" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^4\\d{2}" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          }
        ]
      }
    },
    {
      "title": "CPU & Memory Usage",
      "description": "Node.js process CPU usage (cores) and resident memory (MiB).",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=\"dispatch-api\"}[$__rate_interval])",
          "legendFormat": "CPU (cores)",
          "refId": "A"
        },
        {
          "expr": "process_resident_memory_bytes{job=\"dispatch-api\"} / 1024 / 1024",
          "legendFormat": "Memory (MiB)",
          "refId": "B"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "CPU (cores)" },
            "properties": [
              { "id": "custom.axisPlacement", "value": "left" },
              { "id": "unit", "value": "short" },
              { "id": "custom.axisLabel", "value": "CPU (cores)" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Memory (MiB)" },
            "properties": [
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "unit", "value": "decmbytes" },
              { "id": "custom.axisLabel", "value": "Memory" }
            ]
          }
        ]
      }
    },
    {
      "title": "API Logs",
      "description": "Live container logs from the API service. Uses Loki datasource.",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "{app=\"dispatch-api\"} | json",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["dispatch", "api", "monitoring"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "API Overview",
  "uid": "dispatch-api-overview",
  "version": 1
}
