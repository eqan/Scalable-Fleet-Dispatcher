# ==============================================================
# Local development environment (services on localhost)
# Copy to .env:   cp .env.example .env
# Consumed by: apps/api (src/config/env.ts), ecosystem.config.cjs
# ==============================================================

# ---- Runtime ----
PORT=4000
ENV=development

# ---- Redis (hot state + streams) ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_DB=0

# ---- MongoDB (durable state) ----
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=arqh

# ---- CORS (comma-separated origins or "*") ----
CORS_ORIGIN=*

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_MUTATION_MAX=50

# ---- Performance knobs ----
REHYDRATION_GUARD_CHECK_MS=1000
SSE_REPLAY_BUFFER_SIZE=256
STATE_READ_VALIDATE=false
