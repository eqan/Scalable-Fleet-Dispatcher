{
  "name": "@repo/api",
  "module": "src/bootstrap.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/bootstrap.ts",
    "start": "bun run src/bootstrap.ts",
    "worker": "bun run src/worker.ts",
    "perf": "bun perf/run.ts",
    "perf:viz": "bun perf/visualize.ts",
    "typecheck": "tsc --noEmit",
    "test": "ENV=test bun test --env-file=../../.env.test",
    "test:docker": "API_URL=http://127.0.0.1:4000 bun test tests/integration-docker.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@repo/shared": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.2",
    "mongodb": "^7.1.0",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "zod": "^4.3.6"
  }
}
