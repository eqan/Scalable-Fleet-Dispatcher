# ==============================================================
# Docker Compose environment (uses Docker service hostnames)
# Copy to .env.docker:   cp .env.docker.example .env.docker
# Consumed by: docker-compose.yml (api, worker, web) + interpolation
# ==============================================================

# ---- Runtime ----
# Host-published ports. Override any of these if they clash with something
# already running locally (the bootstrap preflight will tell you which).
PORT=4000
WEB_PORT=5173
GRAFANA_PORT=3001
ENV=development

# ---- Debug port publishing (only used with `./run-platform.sh up --debug`) ----
# Internal services are NOT exposed to the host by default. When you opt into
# debug mode, these control the host ports they bind to.
# REDIS_PUBLISH_PORT=6379
# MONGO_PUBLISH_PORT=27017
# PROMETHEUS_PUBLISH_PORT=9090
# LOKI_PUBLISH_PORT=3100

# ---- Redis (Docker service hostname) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_DB=0

# ---- MongoDB (Docker service hostname) ----
MONGO_URI=mongodb://mongo:27017
MONGO_DATABASE=arqh

# ---- CORS ----
CORS_ORIGIN=*

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_MUTATION_MAX=50

# ---- Performance knobs ----
REHYDRATION_GUARD_CHECK_MS=1000
SSE_REPLAY_BUFFER_SIZE=256
STATE_READ_VALIDATE=false
