# ==============================================================
# Test environment (loaded automatically by `bun run test`)
# apps/api/package.json -> test: ENV=test bun test --env-file=../../.env.test
#
# Points at localhost Redis/MongoDB but isolates state:
#   - REDIS_DB=15         (separate logical DB from dev)
#   - MONGO_DATABASE=arqh_test (dropped/recreated per test run)
# Rate limits are raised so integration tests never hit 429.
# ==============================================================

ENV=test
PORT=4100

# ---- Redis (isolated logical DB) ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_DB=15

# ---- MongoDB (isolated database) ----
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=arqh_test

# ---- CORS ----
CORS_ORIGIN=*

# ---- Rate limiting (relaxed for tests) ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=100000
RATE_LIMIT_MUTATION_MAX=100000

# ---- Performance knobs ----
REHYDRATION_GUARD_CHECK_MS=1000
SSE_REPLAY_BUFFER_SIZE=256
STATE_READ_VALIDATE=true
